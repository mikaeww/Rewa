pkgname=rewa-git
pkgver=0.2.3.r0.g0000000
pkgrel=1
pkgdesc="Lightweight local-first instant replay recorder for Linux desktops"
arch=('x86_64')
url="https://github.com/mikaeww/rewa"
license=('MIT')
depends=(
  'ffmpeg'
  'gpu-screen-recorder'
  'gst-libav'
  'gst-plugins-base'
  'gst-plugins-good'
  'gtk4'
  'libnotify'
  'libpulse'
  'xdg-utils'
)
makedepends=('cargo' 'git')
optdepends=(
  'hyprland: automatic native replay shortcut and focused-monitor detection'
  'xdg-desktop-portal-hyprland: portal capture fallback on Hyprland'
  'xdg-desktop-portal-kde: portal capture fallback on KDE Plasma'
)
provides=('rewa')
# Rewa was published as Wreath; the new package takes the old one's place
conflicts=('rewa' 'wreath' 'wreath-git')
replaces=('wreath' 'wreath-git')
install=rewa.install
source=("$pkgname::git+$url.git")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local description
  if description="$(git describe --long --tags 2>/dev/null)"; then
    printf '%s\n' "$description" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.2.3.r%s.g%s' \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short HEAD)"
  fi
}

build() {
  cd "$pkgname"
  cargo build --locked --release --workspace
}

check() {
  cd "$pkgname"
  cargo test --locked --workspace
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/rewad "$pkgdir/usr/bin/rewad"
  install -Dm755 target/release/rewactl "$pkgdir/usr/bin/rewactl"
  install -Dm755 target/release/rewa-ui "$pkgdir/usr/bin/rewa-ui"

  install -Dm644 packaging/rewad.service \
    "$pkgdir/usr/lib/systemd/user/rewad.service"
  install -Dm644 packaging/io.github.mikaeww.Rewa.desktop \
    "$pkgdir/usr/share/applications/io.github.mikaeww.Rewa.desktop"
  install -Dm644 packaging/io.github.mikaeww.Rewa.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.mikaeww.Rewa.metainfo.xml"
  install -Dm644 packaging/io.github.mikaeww.Rewa.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.mikaeww.Rewa.svg"
  install -Dm644 packaging/io.github.mikaeww.Rewa-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.mikaeww.Rewa-symbolic.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/install.md "$pkgdir/usr/share/doc/$pkgname/install.md"
}
