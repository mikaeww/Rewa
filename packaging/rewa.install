post_install() {
  printf '%s\n' \
    'Rewa installed.' \
    'Enable the recorder with: systemctl --user reenable --now rewad.service' \
    'Coming from Wreath: systemctl --user disable --now wreathd.service' \
    'Hyprland shortcuts are registered automatically.' \
    'On KDE Plasma, assign your preferred shortcut to: rewactl save' \
    'Run `rewactl doctor` to verify capture, GPU, audio, and desktop integration.'
}

post_upgrade() {
  post_install
}
